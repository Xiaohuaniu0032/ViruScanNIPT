# ViruScanNIPT configuration
# Use absolute paths for executables, reference files, and database files.

# Software
BWA=/path/to/bwa
SAMTOOLS=/path/to/samtools
BLASTN=/path/to/blastn

# Human reference and viral BLAST database
HG38_REF=/path/to/GRCh38_no_alt_analysis_set.fa
VIRAL_DB=/path/to/blastdb/viral

# Annotation tables
LOCUS_ORGANISM=/path/to/ViruScanNIPT/database/annotation/locusOrganism.tsv
GROUPNAME_TABLE=/path/to/ViruScanNIPT/database/annotation/viralGroupname.tsv

# Resource parameters
BWA_THREADS=4
BLAST_THREADS=4
MAX_TARGET_SEQS=5
MAX_HSPS=1

# BLAST filters
EVALUE_CUTOFF=1e-5
IDENTITY_CUTOFF=97
ALIGNMENT_LENGTH_CUTOFF=35

# Summary positive definition: distinct query reads per sample per Groupname
POSITIVE_HIT_CUTOFF=2

# 1 = keep SAM/BAM/sorted BAM; 0 = remove selected intermediate files
KEEP_INTERMEDIATE=0
